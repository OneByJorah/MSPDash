# MSPDash — Environment Configuration
# Copy this file to .env and fill in your values.

# ── Dashboard ──────────────────────────────────────────────
COMPOSE_PROJECT_NAME=MSPDash
ADMIN_USER=admin
ADMIN_PASSWORD_BCRYPT=<set-value>
SECRET_KEY=<set-value>
DASHBOARD_PORT=3000
API_PORT=42000

# ── Database ────────────────────────────────────────────────
DATABASE_URL=<set-value>
POSTGRES_USER=msp
POSTGRES_PASSWORD=<set-value>
POSTGRES_DB=msp

# ── Telegram (optional) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=<set-value>
TELEGRAM_ADMIN_CHAT_ID=

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
